# ============ FztbuCS-Project 根级环境变量模板 ============
# 复制为 .env 并替换全部 CHANGE_ME / GENERATE 值：
#   cp .env.example .env
# 密钥生成：
#   openssl rand -hex 32
# 说明：本文件同时驱动根级 docker-compose.yml（外部 PostgreSQL/外部 Redis/backend/worker/cs-website）

# ---- 数据库（服务器已有 PostgreSQL）----
# PostgreSQL 主机：同机 Docker 部署默认使用 host.docker.internal；远程 PG 填实际主机名/IP
DATABASE_HOST=host.docker.internal
# PostgreSQL 端口
DATABASE_PORT=5432
# 数据库名
DATABASE_NAME=domefff
# 数据库用户
DATABASE_USER=postgres
# 必填：服务器 PostgreSQL 连接密码
# 注意：生产数据库需提前创建 DATABASE_NAME，并允许该用户从 Docker 网段连接
DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# 外部 PostgreSQL：默认不自动建库，只执行 Alembic 迁移
DB_AUTO_CREATE_DATABASE=false
DB_AUTO_MIGRATE=true

# ---- 必填密钥 ----
# JWT 签名密钥（≥32 字节，随机生成）
SECRET_KEY=GENERATE_SECURE_KEY
# TOTP 2FA secret 加密密钥（≥32 字节，随机生成）
TOTP_ENCRYPTION_KEY=GENERATE_TOTP_KEY

# ---- 前后端 CORS / Origin ----
# 后端 ALLOWED_ORIGINS：前端访问地址白名单（逗号分隔），默认 http://localhost:2333
# 前端 ALLOWED_ORIGINS：POST 端点 Origin/Referer 校验（防 Login CSRF）
# 两者可用同一份；填写用户实际访问前端的 Origin
ALLOWED_ORIGINS=http://localhost:2333,https://cs.yourdomain.com

# ---- 前端 ----
# Session 密钥（HMAC 签名 session token，生产必须设置 ≥32 字节）
# 生成示例：openssl rand -hex 32
AUTH_SESSION_SECRET=GENERATE_SESSION_SECRET
# 站点 URL（用于 metadata base URL；正式 HTTPS 地址由外部反向代理提供）
NEXT_PUBLIC_SITE_URL=http://localhost:2333
# 是否信任反向代理头（默认直连为 false；外部反代配置完成后改为 true）
TRUST_PROXY=false

# ---- 可选 ----
# 管理员重置用户密码时使用的默认密码
PASSWORD_RESET_DEFAULT=CHANGE_ME_RESET_PASSWORD
# 社区浏览去重 IP 哈希密钥
# COMMUNITY_IP_HASH_SECRET=
# GitHub OAuth（可选）
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://cs.yourdomain.com/api/auth/oauth/github/callback
# SMTP（可选，未配置验证码输出到控制台）
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@cs.yourdomain.com
# Redis（服务器已有实例，生产必填；如启用密码请使用 redis://:密码@主机:6379/0）
REDIS_URL=redis://host.docker.internal:6379/0
# Redis 不可用时拒绝启动/拒绝降级，生产建议开启
REQUIRE_REDIS_FOR_SECURITY=true

# ---- 跨实例事件广播（ADR-014，可选）----
# 多实例部署（多个 backend/worker 副本）时置 true：事件经 arq/redis 广播到所有实例，
# 每个 worker 实例在 on_startup 注册本地订阅者并落地执行。单实例保持 false 零开销。
# MULTI_INSTANCE=false
# 异步任务队列总开关（worker 是否投递到 broker；false 时就地 eager 执行）
# QUEUE_ENABLED=true
