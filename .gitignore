# ============ FztbuCS-Project 根级 .gitignore ============
# 通用排除规范（与子模块共享同一套公共段）。
# 子仓库（CS-Web-Backend / CS-Web-Frontend）各自 .gitignore 在公共段之外，
# 额外保留本语言的专属忽略项。

# ---- 公共段（根级 / 后端 / 前端 三者一致）----

# 环境变量（密钥不入库；模板 .env.example 需提交）
.env
.env.local
.env.*.local

# 日志
*.log

# 开发日志目录（含非 .log 文件时整体排除）
.devlogs/

# IDE / 编辑器 / 工具数据
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.codebuddy/

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
._*

# 运行时数据 / 备份（由 compose 卷挂载到根级 data/ backups/）
data/
backups/

# Redis 快照（运行时数据；可能含会话态，不入库）
dump.rdb
*.rdb
appendonlydir/


# ---- 根级无源码，公共段即全部；语言专属段见子模块 .gitignore ----
